{
  "family": "soc_2",
  "probes": {
    "soc_2.system_description": {
      "type": "clause_document",
      "patterns": [
        "**/system-description*",
        "**/system_description*",
        "docs/**/assurance/*description*"
      ],
      "noun": "system description",
      "provenance": {
        "source": "heuristic (no legal source): file-name convention plus general practice, by topic words only; system description kept for a SOC 2 style assessment",
        "confidence": "low",
        "needs_founder_review": true
      },
      "clauses": {
        "services": {
          "title": "Services provided",
          "markers": [
            {
              "re": "\\bservices?\\b",
