            {
              "re": "\\bcustomers?\\b|\\busers?\\b|\\bclients?\\b",
              "flags": "i"
            }
          ]
        },
        "components": {
          "title": "System components",
          "markers": [
            {
              "re": "\\bcomponents?\\b|\\binfrastructure\\b|\\bsoftware\\b",
              "flags": "i"
            },
            {
              "re": "\\bdata\\b|\\bpeople\\b|\\bprocedures?\\b|\\bhosting\\b",
              "flags": "i"
            }
          ]
        },
        "boundaries": {
          "title": "System boundaries",
          "markers": [
            {
              "re": "\\bboundar(?:y|ies)\\b|\\bscope\\b",
              "flags": "i"
            },
            {
              "re": "\\bin\\s+scope\\b|\\bout\\s+of\\s+scope\\b|\\bexcluded\\b|\\bincluded\\b|\\bsubservice\\b",
              "flags": "i"
            }
          ]
        },
        "commitments": {
          "title": "Service commitments and system requirements",
          "markers": [
            {
              "re": "\\bcommitments?\\b|\\bSLA\\b|\\bagreements?\\b",
              "flags": "i"
            },
            {
              "re": "\\brequirements?\\b|\\bobjectives?\\b|\\buptime\\b|\\bavailability\\b",
              "flags": "i"
            }
          ]
        },
        "incidents": {
          "title": "Incidents in the period",
          "markers": [
            {
              "re": "\\bincidents?\\b|\\bbreach(?:es)?\\b|\\boutages?\\b",
              "flags": "i"
            },
            {
              "re": "\\bperiod\\b|\\bnone\\b|\\bresolved\\b|\\bresponse\\b|\\bcorrective\\b",
              "flags": "i"
            }
          ]
        }
      }
    },
    "soc_2.control_matrix": {
