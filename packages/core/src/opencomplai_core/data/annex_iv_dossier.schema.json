    "ArticleTwelveRecordKeeping": {
      "description": "Automatic logging and record-keeping (Article 12).\n\nWas previously emitted as \"Annex IV Section 4\", which conflated two\ndistinct obligations: Art. 12 requires high-risk systems to log\nautomatically over their lifetime, while Annex IV point 4 concerns the\nappropriateness of performance metrics.\n\nThe first three fields are provider declarations copied from the manifest;\nabsent means false (retention: absent, not null). `provider_supplied` says\nwhether the manifest declared the block at all. `ledger_root_hash` is\nmeasured, not declared.",
      "properties": {
        "evidence_vault_enabled": {
          "default": false,
          "title": "Evidence Vault Enabled",
          "type": "boolean"
        },
        "ledger_root_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ledger Root Hash"
        },
        "log_retention_days": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Retention Days"
        },
        "logging_enabled": {
          "default": false,
          "title": "Logging Enabled",
          "type": "boolean"
        },
        "provider_supplied": {
          "default": false,
          "title": "Provider Supplied",
          "type": "boolean"
        }
      },
      "title": "ArticleTwelveRecordKeeping",
      "type": "object"
    },
    "ComplianceTarget": {
      "description": "Compliance framework a system is assessed against (D-3c).\n\n`EU_AI_ACT` is evaluated: `opencomplai gaps`/`check` compute a\ndeterministic per-article verdict for it. `NIST_AI_RMF` is evaluated by\nre-projecting that same EU AI Act evidence through\n`data/framework_crosswalk.json` into per-subcategory NIST AI RMF 1.0\nverdicts (`nist_rmf_report.py`). Coverage is partial: a subcategory with\nno crosswalk row stays Unverified, never guessed. ISO/IEC 42001:2023 has\nno member here, because a new member would change the published dossier\nschema: it is the `ISO_IEC_42001` native framework pack in\n`frameworks.py`, attestation-led (partial, unreviewed), selected through\n`compliance_targets` or `--target ISO_IEC_42001`. Its per-article clause\ncitation (`control_catalog`, the Mapped column of `opencomplai gaps`)\nstays a reference, not a verdict. Nothing here certifies ISO/IEC 42001\nconformity.",
      "enum": [
        "EU_AI_ACT",
        "NIST_AI_RMF"
      ],
      "title": "ComplianceTarget",
      "type": "string"
    },
    "HumanOversight": {
      "additionalProperties": false,
      "description": "Declared human-oversight arrangement; a statement, never verified.",
      "properties": {
        "escalation": {
          "anyOf": [
