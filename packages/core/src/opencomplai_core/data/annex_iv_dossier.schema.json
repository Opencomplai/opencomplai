    "AnnexIVSection8": {
      "description": "EU declaration of conformity (Annex IV, point 8; Article 47).\n\nAnnex IV point 8 requires a *copy* of the declaration. This dossier records\na reference to it \u2014 the declaration itself is a signed provider document\nthat this engine neither holds nor can produce. `declaration_sha256` is\nthe SHA-256 of that signed document as uploaded to the evidence vault, so\na verifier can confirm the referenced file matches this dossier without\nthe file itself being embedded here (see docs/src/concepts/annex-iv-coverage.md).",
      "properties": {
        "declaration_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declaration Reference"
        },
        "declaration_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declaration Sha256"
        },
        "note": {
          "default": "Not supplied. This section requires a provider attestation and cannot be derived automatically from the repository.",
          "title": "Note",
          "type": "string"
        },
        "provider_supplied": {
          "default": false,
          "title": "Provider Supplied",
          "type": "boolean"
        }
      },
      "title": "AnnexIVSection8",
      "type": "object"
    },
    "AnnexIVSection9": {
