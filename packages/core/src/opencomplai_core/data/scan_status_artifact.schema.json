          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The framework_crosswalk.json row confidence ('low'|'medium'|'high') this verdict was re-projected through; None when no crosswalk row maps to this subcategory's category.",
          "title": "Mapping Confidence"
        },
        "needs_founder_review": {
          "default": true,
          "title": "Needs Founder Review",
          "type": "boolean"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "source_eu_ai_act_articles": {
          "description": "EU AI Act articles this verdict was derived from (citation trail)",
          "items": {
            "type": "string"
          },
          "title": "Source Eu Ai Act Articles",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GapStatus"
        },
        "subcategory": {
          "description": "e.g. 'GOVERN 1.1'",
          "title": "Subcategory",
          "type": "string"
        }
      },
      "required": [
        "subcategory",
        "function",
        "category",
        "status"
      ],
      "title": "RmfSubcategoryStatus",
      "type": "object"
