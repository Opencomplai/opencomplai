{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opencomplai.dev/proposal_leads/v1",
  "title": "Proposal leads",
  "description": "Leads, not findings. Pointers for a person to review, produced by the deterministic matcher. A lead has no severity, never changes an exit code or a verdict and is never part of the signed artifact.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/lead"
  },
  "$defs": {
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "file",
        "line",
        "function",
        "annex_iii_area",
        "confidence_band",
        "signals"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["deterministic_matcher"]
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "function": {
          "type": "string"
        },
        "annex_iii_area": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "confidence_band": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
