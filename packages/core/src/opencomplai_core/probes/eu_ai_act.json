      "markers": {
        "all": [
          {
            "re": "risk[\\s_-]*(identification|analysis|assessment)|identified\\s+risks|hazard",
            "flags": "i"
          },
          {
            "re": "mitigat|control\\s+measure|treatment|residual\\s+risk",
            "flags": "i"
          }
        ],
        "found_label": "risk identification + mitigation",
        "lacks_label": "risk-identification and mitigation",
        "noun": "risk register",
        "forbid_scaffold": true
      }
    },
