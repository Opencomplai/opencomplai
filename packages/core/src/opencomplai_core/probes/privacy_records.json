{
  "family": "privacy_records",
  "probes": {
    "dpia_document": {
      "patterns": [
        "DPIA.md",
        "docs/**/dpia*",
        "**/data-protection-impact-assessment*",
        "**/data_protection_impact_assessment*"
      ],
      "markers": {
        "all": [
          {
            "re": "\\b(?:necessity|necessary|proportionality|proportionate)\\b",
            "flags": "i"
          },
          {
            "re": "\\brisks?\\b[^\\n]{0,80}\\b(?:individuals?|data subjects?|people|persons?)\\b|\\b(?:individuals?|data subjects?|people|persons?)\\b[^\\n]{0,80}\\brisks?\\b",
            "flags": "i"
          },
          {
            "re": "\\b(?:measures?|mitigations?|safeguards?|controls?)\\b",
            "flags": "i"
          }
        ],
        "found_label": "a necessity statement, risks to individuals and measures",
        "lacks_label": "necessity, risks-to-individuals and measures content and minimum body length",
        "noun": "DPIA",
        "body_only": true,
        "forbid_scaffold": true
      },
      "provenance": {
        "source": "heuristic (no legal source): file-name convention plus general-practice marker words",
        "confidence": "low",
        "needs_founder_review": true
      }
    },
