# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.mypy_cache/

# uv — DO NOT ignore uv.lock
.venv/

# Node.js
node_modules/
dist/
*.js.map
.pnpm-store/

# Editors
.idea/
.vscode/
*.swp
.DS_Store
.cursor/*
.autopilot.json

# Secrets
.env
*.pem
*.key

# Docs build output
site/
docs/site/
docs-env/
.mkdocs/

# Build artifacts
.mintlify/

# Opencomplai generated artifacts (output of `opencomplai init` / `opencomplai check`)
compliance-artifact.json
system-manifest.json
# ...but keep the committed example fixtures used by the scanner docs
!examples/sample-system/**/system-manifest.json
!tests/fixtures/**/system-manifest.json
.venv-ci-check/*
# GitHub issues sync output (local mirror; may contain PII from issues)
github-issues/

docs/src/assets/js/checker-widget.js
docs/checker-widget/src/data/
docs/checker-widget/node_modules/
# checker-local.html is committed on purpose: packages/cli/pyproject.toml
# force-includes it in the wheel, so ignoring it left a fresh clone unable to
# install by any documented path (issue #48, finding 9). The build is
# deterministic; CI (ci-node.yml checker-widget job) rebuilds and fails on
# drift.

# --- Public-repo hardening (keep AI-tooling and internal artifacts out) ---
.oss-sync-state
.claude/
.cursor/
.autopilot.json
.selfaudit/
compliance-reports/
*.plan.md
x.key
.tmp-*.db
ci-logs/
tmp/

.vercel
.env*.local

# `vercel env pull <environment>` writes to a file named after the environment
# when no `-o` path is given, so a mistyped pull drops a real token into the
# repo root under a name none of the patterns above match. Ignore the three
# environment names outright rather than relying on catching it in review.
/development
/preview
/production

# Scratch worktrees created by local agent tooling.
.harness-worktrees/

.vercel
